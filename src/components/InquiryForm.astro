---
import {
  INVOLVEMENT_CHOICES,
  OCCUPANCY,
  PROPERTY_TYPES,
  TIMELINES,
  type FieldErrors,
  type FormValues,
} from '~/lib/inquiry';

interface Props {
  errors?: FieldErrors;
  values?: FormValues;
  /** A failure that is not tied to one field, e.g. the spam check. */
  formError?: string;
}

const { errors = {}, values = {}, formError } = Astro.props;

const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const v = (field: string) => values[field] ?? '';

const errorList = (
  Object.entries(errors) as [keyof FieldErrors, string][]
).filter(([, message]) => Boolean(message));

const selects = [
  { name: 'propertyType', label: 'Property type', options: PROPERTY_TYPES },
  { name: 'occupancy', label: 'Current status', options: OCCUPANCY },
  {
    name: 'involvement',
    label: 'How involved do you want to be?',
    options: INVOLVEMENT_CHOICES,
  },
  { name: 'timeline', label: 'When would you like to start?', options: TIMELINES },
] as const;
---

<form method="post" action="/contact#form-errors" novalidate class="max-w-2xl">
  {/*
    Error summary. role="alert" announces it the moment the page re-renders
    after a failed submit, and each entry jumps to the field it belongs to.
  */}
  {
    (errorList.length > 0 || formError) && (
      <div
        role="alert"
        tabindex="-1"
        id="form-errors"
        class="mb-8 rounded-md border-2 border-[#b42318] bg-[#fef3f2] p-4 text-[#7a271a] dark:bg-[#2b1513] dark:text-[#fda29b]"
      >
        <h3 class="font-sans text-base font-semibold">
          {formError
            ? 'We could not send your inquiry'
            : errorList.length === 1
              ? 'One field needs your attention'
              : `${errorList.length} fields need your attention`}
        </h3>
        {formError && <p class="mt-2 text-sm">{formError}</p>}
        {errorList.length > 0 && (
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
            {errorList.map(([field, message]) => (
              <li>
                <a href={`#${field}`} class="underline underline-offset-2">
                  {message}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }

  <div class="space-y-6">
    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for="name" class="field-label">
          Your name <span aria-hidden="true" class="text-accent">*</span>
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          value={v('name')}
          aria-invalid={errors.name ? 'true' : undefined}
          aria-describedby={errors.name ? 'name-error' : undefined}
          class="field-input"
        />
        {errors.name && <span id="name-error" class="field-error">{errors.name}</span>}
      </div>

      <div>
        <label for="email" class="field-label">
          Email <span aria-hidden="true" class="text-accent">*</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          value={v('email')}
          aria-invalid={errors.email ? 'true' : undefined}
          aria-describedby={errors.email ? 'email-error' : undefined}
          class="field-input"
        />
        {errors.email && <span id="email-error" class="field-error">{errors.email}</span>}
      </div>
    </div>

    <div>
      <label for="phone" class="field-label">Phone</label>
      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        value={v('phone')}
        aria-invalid={errors.phone ? 'true' : undefined}
        aria-describedby={errors.phone ? 'phone-error' : 'phone-hint'}
        class="field-input"
      />
      {
        errors.phone ? (
          <span id="phone-error" class="field-error">{errors.phone}</span>
        ) : (
          <span id="phone-hint" class="mt-1.5 block text-sm text-ink-muted">
            Optional. Include a country code if you are outside the United States.
          </span>
        )
      }
    </div>

    <div>
      <label for="propertyAddress" class="field-label">
        Property address <span aria-hidden="true" class="text-accent">*</span>
      </label>
      <input
        id="propertyAddress"
        name="propertyAddress"
        type="text"
        required
        autocomplete="street-address"
        value={v('propertyAddress')}
        aria-invalid={errors.propertyAddress ? 'true' : undefined}
        aria-describedby={
          errors.propertyAddress ? 'propertyAddress-error' : 'propertyAddress-hint'
        }
        class="field-input"
      />
      {
        errors.propertyAddress ? (
          <span id="propertyAddress-error" class="field-error">
            {errors.propertyAddress}
          </span>
        ) : (
          <span id="propertyAddress-hint" class="mt-1.5 block text-sm text-ink-muted">
            City and ZIP are enough if you would rather not give the full address yet.
          </span>
        )
      }
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        selects.map((select) => (
          <div>
            <label for={select.name} class="field-label">
              {select.label}
            </label>
            <select id={select.name} name={select.name} class="field-input">
              <option value="">Please choose</option>
              {select.options.map((option) => (
                <option value={option} selected={v(select.name) === option}>
                  {option}
                </option>
              ))}
            </select>
          </div>
        ))
      }
    </div>

    <div>
      <label for="message" class="field-label">
        Anything else we should know?
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        class="field-input"
        aria-describedby="message-hint">{v('message')}</textarea
      >
      <span id="message-hint" class="mt-1.5 block text-sm text-ink-muted">
        Current rent, HOA details, upcoming lease dates, anything that helps us
        prepare a useful proposal.
      </span>
    </div>

    <div class="rounded-md bg-surface-2 p-4">
      <div class="flex gap-3">
        <input
          id="consent"
          name="consent"
          type="checkbox"
          value="yes"
          required
          checked={v('consent') === 'yes'}
          aria-invalid={errors.consent ? 'true' : undefined}
          aria-describedby={errors.consent ? 'consent-error' : undefined}
          class="mt-0.5 size-5 shrink-0 rounded border-line-strong"
        />
        <label for="consent" class="text-sm leading-relaxed text-ink">
          Yes, you may contact me about this inquiry by email or phone.
          <span aria-hidden="true" class="text-accent">*</span>
        </label>
      </div>
      {errors.consent && <span id="consent-error" class="field-error">{errors.consent}</span>}
      <p class="mt-3 text-xs leading-relaxed text-ink-muted">
        We use what you send here to respond to your inquiry and prepare a
        proposal. We do not sell it. See our <a
          href="/privacy"
          class="underline underline-offset-2">privacy policy</a
        >.
      </p>
    </div>

    {/* Honeypot. Hidden from sight and from assistive technology. */}
    <div class="hp-field" aria-hidden="true">
      <label for="company_website">Company website</label>
      <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-size="flexible"></div>}

    <div>
      <button type="submit" class="btn btn-primary w-full sm:w-auto">
        Send my inquiry
      </button>
      <p class="mt-3 text-sm text-ink-muted">
        Fields marked <span aria-hidden="true" class="text-accent">*</span><span
          class="sr-only">with an asterisk</span
        > are required.
      </p>
    </div>
  </div>
</form>

{
  turnstileKey && (
    <script
      is:inline
      defer
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    />
  )
}
