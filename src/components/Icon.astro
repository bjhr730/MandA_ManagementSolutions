---
import type { IconName } from '~/content/services';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-6' } = Astro.props;

/** 24x24 stroke paths. Decorative: always aria-hidden, label the heading. */
const paths: Record<IconName, string[]> = {
  building: ['M4 21h16', 'M6 21V5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v16', 'M10 8h4M10 12h4M10 16h4'],
  banknote: ['M2 7h20v10H2z', 'M12 12h.01', 'M6 10v4M18 10v4'],
  wrench: [
    'M14.7 6.3a4 4 0 1 0 5 5L21 21h-3l-6.5-6.5',
    'M9 9 4 4l1-1 5 5',
  ],
  users: [
    'M16 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1',
    'M9.5 7.5a2.75 2.75 0 1 0 0 5.5 2.75 2.75 0 0 0 0-5.5z',
    'M17 11a2.5 2.5 0 1 0 0-5',
    'M21 20v-1a3.5 3.5 0 0 0-2.5-3.35',
  ],
  clipboard: [
    'M9 4h6v3H9z',
    'M9 5.5H7a1 1 0 0 0-1 1V20a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V6.5a1 1 0 0 0-1-1h-2',
    'M9 12h6M9 16h4',
  ],
  refresh: [
    'M20 11a8 8 0 0 0-13.9-5.4L3 8',
    'M3 4v4h4',
    'M4 13a8 8 0 0 0 13.9 5.4L21 16',
    'M21 20v-4h-4',
  ],
  key: [
    'M15.5 8.5a3.5 3.5 0 1 1-3.4 4.4L9 16h-2v2H5v2H3v-3l6.1-6.1A3.5 3.5 0 0 1 15.5 8.5z',
  ],
};
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
