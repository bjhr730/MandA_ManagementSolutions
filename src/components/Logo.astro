---
/**
 * Typographic wordmark, standing in until a real logo exists.
 *
 * It is drawn in text rather than an image so it is crisp at every size,
 * costs no bytes, and is readable by assistive technology. When the real logo
 * arrives, replace the markup here and nothing else changes.
 */
interface Props {
  /** Larger treatment for the footer. */
  size?: 'sm' | 'md';
  /** Light text, for use on the dark footer and CTA bands. */
  onDark?: boolean;
}

const { size = 'sm', onDark = false } = Astro.props;

const mark = size === 'sm' ? 'text-[1.0625rem]' : 'text-xl';
const rule = size === 'sm' ? 'h-4' : 'h-5';
---

<span class={`inline-flex items-baseline gap-2 font-serif font-semibold tracking-tight ${mark} ${onDark ? 'text-white' : 'text-ink'}`}>
  <span>M&amp;A</span>
  <span
    aria-hidden="true"
    class={`${rule} w-px self-center ${onDark ? 'bg-white/40' : 'bg-line-strong'}`}
  ></span>
  <span
    class={`font-sans text-[0.625rem] font-semibold uppercase leading-tight tracking-[0.14em] ${onDark ? 'text-silver-300' : 'text-ink-muted'}`}
    >Management <br />Solutions</span
  >
</span>
