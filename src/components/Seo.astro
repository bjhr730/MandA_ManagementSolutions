---
import { BRAND, INDEXABLE, LEGAL_ENTITY, SITE_URL } from '~/config/site';

interface Props {
  title: string;
  description: string;
  /** Keep this page out of search results and the sitemap. */
  noindex?: boolean;
  /** Absolute or site-relative image for social cards. */
  image?: string;
}

const { title, description, noindex = false, image = '/og.png' } = Astro.props;

const origin = Astro.site?.origin ?? SITE_URL;
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', origin);
const ogImage = new URL(image, origin);

// Home page shows the brand alone; inner pages get the suffix.
const fullTitle =
  Astro.url.pathname === '/' ? title : `${title} | ${BRAND}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

{
  /* Page-level opt-out, or the site-wide pre-launch block. */
  !INDEXABLE ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : null
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={LEGAL_ENTITY} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />
