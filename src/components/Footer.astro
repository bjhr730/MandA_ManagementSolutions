---
import Logo from './Logo.astro';
import {
  BROKERAGE_DISCLOSURE,
  EQUAL_HOUSING,
  REVIEW_MODE,
} from '~/config/compliance';
import {
  CONTACT,
  FOOTER_NAV,
  LEGAL_ENTITY,
  PORTALS_LIVE,
  SERVICE_AREAS,
} from '~/config/site';

const year = new Date().getFullYear();

// The portals page is only worth linking to once the portals exist.
const serviceLinks = FOOTER_NAV.services.filter(
  (link) => PORTALS_LIVE || link.href !== '/portals'
);
---

<footer class="mt-24 bg-navy-800 text-silver-200">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <Logo size="md" onDark />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-silver-300">
          Residential property management for Northern Virginia owners.
        </p>
        <dl class="mt-5 space-y-1.5 text-sm">
          <div>
            <dt class="sr-only">Phone</dt>
            <dd>
              <a
                href={CONTACT.phoneHref}
                class="font-medium text-white underline decoration-white/40 underline-offset-4 hover:decoration-white"
                >{CONTACT.phone}</a
              >
            </dd>
          </div>
          <div>
            <dt class="sr-only">Email</dt>
            <dd>
              <a
                href={`mailto:${CONTACT.email}`}
                class="text-silver-200 underline decoration-white/30 underline-offset-4 hover:text-white"
                >{CONTACT.email}</a
              >
            </dd>
          </div>
          <div class="pt-1 text-silver-300">
            <dt class="sr-only">Hours</dt>
            <dd>{CONTACT.hours}</dd>
          </div>
        </dl>
      </div>

      <nav aria-labelledby="footer-company">
        <h2 id="footer-company" class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-silver-400">
          Company
        </h2>
        <ul class="mt-4 space-y-1">
          {
            FOOTER_NAV.company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-9 items-center text-sm text-silver-200 hover:text-white hover:underline hover:underline-offset-4"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-services">
        <h2 id="footer-services" class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-silver-400">
          Services
        </h2>
        <ul class="mt-4 space-y-1">
          {
            serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-9 items-center text-sm text-silver-200 hover:text-white hover:underline hover:underline-offset-4"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-legal">
        <h2 id="footer-legal" class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-silver-400">
          Legal
        </h2>
        <ul class="mt-4 space-y-1">
          {
            FOOTER_NAV.legal.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-9 items-center text-sm text-silver-200 hover:text-white hover:underline hover:underline-offset-4"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-silver-400">
        Service area
      </h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-silver-300">
        {SERVICE_AREAS.join(' \u00b7 ')}
      </p>
    </div>

    <div class="mt-8 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-start sm:gap-5">
      <svg
        aria-hidden="true"
        viewBox="0 0 48 48"
        class="h-10 w-10 shrink-0 text-silver-300"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path d="M6 22 24 8l18 14" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M10 22v18h28V22" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M17 28h14M17 34h14" stroke-linecap="round"></path>
      </svg>
      <div>
        <p class="text-sm font-semibold text-white">Equal Housing Opportunity</p>
        <p class="mt-1.5 max-w-3xl text-xs leading-relaxed text-silver-300">
          {EQUAL_HOUSING}
        </p>
        <p class="mt-2 text-xs text-silver-300">
          <a href="/fair-housing" class="underline underline-offset-4 hover:text-white"
            >Read our full fair housing statement</a
          >
        </p>
      </div>
    </div>

    <div class="mt-8 space-y-3 border-t border-white/10 pt-8 text-xs leading-relaxed text-silver-400">
      <p>{BROKERAGE_DISCLOSURE}</p>
      {
        REVIEW_MODE && (
          <p class="font-semibold text-bronze-300">
            Pre-launch draft: licensing, brokerage and fair housing disclosures
            on this site are placeholders pending review by a qualified
            Virginia professional.
          </p>
        )
      }
      <p>
        &copy; {year} {LEGAL_ENTITY}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
