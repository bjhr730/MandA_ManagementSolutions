---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="border-b border-line bg-surface-2">
  <div class="container-page py-12 md:py-16">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-h2 md:text-display">{title}</h1>
    {
      lead && (
        <p class="mt-5 max-w-2xl text-lead text-ink-muted">{lead}</p>
      )
    }
  </div>
</div>
