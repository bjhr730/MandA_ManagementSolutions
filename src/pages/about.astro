---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import JsonLd from '~/components/JsonLd.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';

import { ABOUT_MISSION, ABOUT_PARAGRAPHS } from '~/content/about';
import { PRINCIPLES } from '~/content/philosophy';
import { breadcrumbs } from '~/lib/schema';
---

<BaseLayout
  title="About Us"
  description="M&A Management Solutions is a Northern Virginia property management company helping residential owners protect their investments, maximize their property's potential and enjoy greater peace of mind."
>
  <JsonLd slot="head" schema={breadcrumbs([{ name: 'About Us', path: '/about' }])} />

  <PageHeader
    eyebrow="About us"
    title="About M&A Management Solutions"
    lead="Experience, integrity and accountability, applied to residential property in Northern Virginia."
  />

  <Section labelledby="story-heading">
    <h2 id="story-heading" class="sr-only">Who we are</h2>
    <div class="prose-site text-lead text-ink-muted">
      {ABOUT_PARAGRAPHS.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <blockquote
      class="mt-14 max-w-3xl border-l-4 border-accent bg-surface-2 px-6 py-6 md:px-8"
    >
      <p class="font-serif text-h3 text-ink">{ABOUT_MISSION}</p>
      <footer class="mt-3 text-sm font-medium text-ink-muted">
        Our mission
      </footer>
    </blockquote>
  </Section>

  <Section tone="muted" labelledby="principles-heading">
    <p class="eyebrow">What guides us</p>
    <h2 id="principles-heading" class="mt-3 max-w-2xl text-h2">
      Three principles behind every decision
    </h2>

    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {
        PRINCIPLES.map((principle) => (
          <li class="rounded-lg border border-line bg-surface p-6">
            <p class="font-serif text-sm font-semibold text-accent">
              {principle.number}
            </p>
            <h3 class="mt-3 text-h3">{principle.title}</h3>
            <p class="mt-3 font-serif text-ink italic">{principle.statement}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/philosophy" class="btn btn-secondary">Our philosophy in full</a>
      <a href="/founder" class="btn btn-secondary">Meet the founder</a>
    </div>
  </Section>

  <Cta />
</BaseLayout>
