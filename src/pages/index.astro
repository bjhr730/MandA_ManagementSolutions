---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import FaqList from '~/components/FaqList.astro';
import Icon from '~/components/Icon.astro';
import JsonLd from '~/components/JsonLd.astro';
import Section from '~/components/Section.astro';

import { BENEFITS, HERO, HOME_FOUNDER_TEASER } from '~/content/home';
import { FEATURED_FAQ } from '~/content/faq';
import { FOUNDER_STATS } from '~/content/founder';
import { PRINCIPLES } from '~/content/philosophy';
import { SERVICES } from '~/content/services';
import { SERVICE_AREAS } from '~/config/site';
import { founderPerson, localBusiness } from '~/lib/schema';
---

<BaseLayout
  title="M&A Management Solutions | Northern Virginia Property Management"
  description="Residential property management for Northern Virginia owners, run by a licensed broker who owns rental property himself. Transparent reporting, no termination fees, management shaped around you."
>
  <JsonLd slot="head" schema={localBusiness()} />
  <JsonLd slot="head" schema={founderPerson()} />

  {/* ---------------------------------------------------------------- Hero */}
  <div class="border-b border-line bg-surface-2">
    <div class="container-page py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">{HERO.eyebrow}</p>
        <h1 class="mt-4 text-display">{HERO.headline}</h1>
        <p class="mt-6 max-w-2xl text-lead text-ink-muted">{HERO.subhead}</p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={HERO.primaryCta.href} class="btn btn-primary">
            {HERO.primaryCta.label}
          </a>
          <a href={HERO.secondaryCta.href} class="btn btn-secondary">
            {HERO.secondaryCta.label}
          </a>
        </div>
      </div>

      <dl class="mt-14 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-8 border-t border-line pt-8 sm:grid-cols-3">
        {
          FOUNDER_STATS.map((stat) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1 text-sm leading-snug text-ink-muted">
                {stat.label}
              </dt>
              <dd class="font-serif text-2xl font-semibold text-ink md:text-3xl">
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  {/* ------------------------------------------------------------ Benefits */}
  <Section labelledby="benefits-heading">
    <h2 id="benefits-heading" class="text-h2 max-w-2xl">
      What owners actually get
    </h2>
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        BENEFITS.map((benefit) => (
          <li class="border-t-2 border-accent pt-5">
            <h3 class="text-h3">{benefit.title}</h3>
            <p class="mt-3 text-ink-muted">{benefit.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ------------------------------------------------------------ Services */}
  <Section tone="muted" labelledby="services-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">Our services</p>
        <h2 id="services-heading" class="mt-3 text-h2">
          Everything the property needs, in one place
        </h2>
      </div>
      <a
        href="/services"
        class="text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
      >
        See all services
      </a>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        SERVICES.map((service) => (
          <li class="flex gap-4 rounded-lg border border-line bg-surface p-5">
            <span class="mt-0.5 text-accent">
              <Icon name={service.icon} />
            </span>
            <div>
              <h3 class="font-serif text-base font-semibold text-ink">
                {service.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                {service.summary}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ------------------------------------------------------------- Founder */}
  <Section labelledby="founder-heading">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:items-center lg:gap-16">
      {/*
        Headshot slot. The checklist calls for a professional portrait, which
        does not exist yet; this placeholder holds the exact 4:5 box so the
        real photo drops in without any layout change.
      */}
      <div
        class="flex aspect-4/5 w-full max-w-sm items-center justify-center rounded-lg border border-dashed border-line-strong bg-surface-3"
      >
        <p class="px-6 text-center text-sm text-ink-muted">
          Professional headshot
          <span class="mt-1 block text-xs">
            Replace with a 4:5 portrait at 1000&times;1250 or larger
          </span>
        </p>
      </div>

      <div>
        <p class="eyebrow">Meet the founder</p>
        <h2 id="founder-heading" class="mt-3 text-h2">Antonio Melendez</h2>
        <p class="mt-2 text-sm font-medium text-ink-muted">
          Founder &middot; Real Estate Broker &middot; Property Investor
        </p>

        <blockquote class="mt-8 border-l-2 border-accent pl-5">
          <p class="font-serif text-lead text-ink italic">
            &ldquo;Your property deserves the same attention, care, and
            commitment I would give my own.&rdquo;
          </p>
        </blockquote>

        <p class="mt-7 text-ink-muted">{HOME_FOUNDER_TEASER}</p>

        <a
          href="/founder"
          class="mt-7 inline-flex min-h-11 items-center text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
        >
          Read Antonio&rsquo;s full background
        </a>
      </div>
    </div>
  </Section>

  {/* ---------------------------------------------------------- Philosophy */}
  <Section tone="inverse" labelledby="philosophy-heading">
    <p class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-bronze-300">
      Our philosophy
    </p>
    <h2 id="philosophy-heading" class="mt-3 max-w-2xl text-h2 text-white">
      Three principles, applied to every decision
    </h2>

    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        PRINCIPLES.map((principle) => (
          <li>
            <p class="font-serif text-sm font-semibold text-bronze-300">
              {principle.number}
            </p>
            <h3 class="mt-3 font-serif text-lg font-semibold text-white">
              {principle.title}
            </h3>
            <p class="mt-3 text-silver-200 italic">{principle.statement}</p>
          </li>
        ))
      }
    </ol>

    <a
      href="/philosophy"
      class="mt-12 inline-flex min-h-11 items-center text-sm font-semibold text-white underline decoration-bronze-300 decoration-2 underline-offset-4"
    >
      Read our philosophy in full
    </a>
  </Section>

  {/* ----------------------------------------------------------------- FAQ */}
  <Section labelledby="faq-heading">
    <div class="max-w-3xl">
      <p class="eyebrow">Owner questions</p>
      <h2 id="faq-heading" class="mt-3 text-h2">The ones owners ask first</h2>
      <div class="mt-10">
        <FaqList entries={FEATURED_FAQ} />
      </div>
      <a
        href="/faq"
        class="mt-8 inline-flex min-h-11 items-center text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
      >
        All 13 questions
      </a>
    </div>
  </Section>

  {/* --------------------------------------------------------- Service area */}
  <Section tone="muted" compact labelledby="area-heading">
    <h2 id="area-heading" class="text-h3">Where we work</h2>
    <p class="mt-4 max-w-3xl text-ink-muted">
      We manage residential property across Northern Virginia, including {
        SERVICE_AREAS.slice(0, -1).join(', ')
      } and {SERVICE_AREAS.at(-1)}. Out-of-state and international owners are
      welcome; we work by email, phone and WhatsApp.
    </p>
  </Section>

  <Cta />
</BaseLayout>
