---
// Rendered on demand so the page can handle its own POST and re-render with
// the submitted values and per-field errors intact, with no JavaScript.
export const prerender = false;

import BaseLayout from '~/layouts/BaseLayout.astro';
import Disclosure from '~/components/Disclosure.astro';
import InquiryForm from '~/components/InquiryForm.astro';
import JsonLd from '~/components/JsonLd.astro';
import Section from '~/components/Section.astro';

import { handleInquiry, type InquiryResult } from '~/lib/inquiry';
import { CONTACT, SERVICE_AREAS } from '~/config/site';
import { breadcrumbs, localBusiness } from '~/lib/schema';

let result: InquiryResult | null = null;

if (Astro.request.method === 'POST') {
  result = await handleInquiry(Astro.request);
  if (result.status === 'ok') {
    // POST-redirect-GET: a refresh on the thank-you page resends nothing.
    return Astro.redirect('/thank-you', 303);
  }
}

const errors = result?.status === 'invalid' ? result.errors : {};
const values = result ? result.values : {};
const formError = result?.status === 'error' ? result.message : undefined;
---

<BaseLayout
  title="Contact & Owner Consultation"
  description="Request an owner consultation or rental evaluation for your Northern Virginia property. Tell us about the property and we will come back with a written proposal."
>
  <JsonLd slot="head" schema={localBusiness()} />
  <JsonLd
    slot="head"
    schema={breadcrumbs([{ name: 'Contact', path: '/contact' }])}
  />

  <div class="border-b border-line bg-surface-2">
    <div class="container-page py-12 md:py-16">
      <p class="eyebrow">Owner consultation</p>
      <h1 class="mt-3 max-w-3xl text-h2 md:text-display">
        Tell us about your property
      </h1>
      <p class="mt-5 max-w-2xl text-lead text-ink-muted">
        A consultation costs nothing and commits you to nothing. We will look
        at the property, talk through what you want from management, and come
        back to you in writing.
      </p>
    </div>
  </div>

  <Section>
    <div class="grid gap-14 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
      <div id="inquiry" class="scroll-mt-24">
        <h2 class="text-h2">Request a consultation or rental evaluation</h2>
        <p class="mt-4 max-w-2xl text-ink-muted">
          The more you can tell us now, the more useful our first reply will be.
        </p>

        <div class="mt-10">
          <InquiryForm errors={errors} values={values} formError={formError} />
        </div>
      </div>

      <aside class="lg:border-l lg:border-line lg:pl-12">
        <h2 class="text-h3">Reach us directly</h2>
        <dl class="mt-6 space-y-5">
          <div>
            <dt class="text-sm font-semibold text-ink-muted">Phone</dt>
            <dd class="mt-1">
              <a
                href={CONTACT.phoneHref}
                class="text-lead font-medium text-ink underline decoration-accent decoration-2 underline-offset-4"
                >{CONTACT.phone}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-ink-muted">Email</dt>
            <dd class="mt-1">
              <a
                href={`mailto:${CONTACT.email}`}
                class="break-words font-medium text-ink underline decoration-accent decoration-2 underline-offset-4"
                >{CONTACT.email}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-ink-muted">Hours</dt>
            <dd class="mt-1 text-ink">{CONTACT.hours}</dd>
          </div>
        </dl>

        {
          CONTACT.whatsapp && (
            <div class="mt-8 rounded-lg border border-line bg-surface-2 p-5">
              <h3 class="font-serif text-base font-semibold text-ink">
                Out of state or overseas?
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                We work with owners who live locally, elsewhere in the United
                States, or abroad, by email, phone or WhatsApp.
              </p>
            </div>
          )
        }

        <div class="mt-8">
          <h3 class="text-sm font-semibold text-ink-muted">Service area</h3>
          <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-sm text-ink">
            {
              SERVICE_AREAS.map((area, index) => (
                <li>
                  {area}
                  {index < SERVICE_AREAS.length - 1 && (
                    <span aria-hidden="true" class="text-silver-400"> &middot;</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-8">
          <Disclosure label="Your information">
            <p>
              We use what you send to respond to your inquiry and prepare a
              proposal. Submitting this form does not create a management
              agreement or any obligation on either side.
            </p>
          </Disclosure>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
