---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import Section from '~/components/Section.astro';
import { CONTACT, PORTALS, PORTALS_LIVE } from '~/config/site';
---

<BaseLayout
  title="Owner & Resident Portals"
  description="Online portals for owners and residents: statements, documents, maintenance requests and payments."
  noindex={!PORTALS_LIVE}
>
  <Section>
    <div class="max-w-2xl">
      <p class="eyebrow">Portals</p>
      <h1 class="mt-3 text-display">Owner &amp; resident portals</h1>

      {
        PORTALS_LIVE ? (
          <>
            <p class="mt-5 text-lead text-ink-muted">
              Owners can view statements, documents and disbursement history.
              Residents can submit maintenance requests and make payments.
            </p>
            <div class="mt-10 grid gap-5 sm:grid-cols-2">
              <a
                href={PORTALS.owner}
                class="rounded-lg border border-line bg-surface-2 p-6 hover:border-line-strong"
              >
                <h2 class="text-h3">Owner portal</h2>
                <p class="mt-2 text-sm text-ink-muted">
                  Statements, documents and disbursements.
                </p>
              </a>
              <a
                href={PORTALS.tenant}
                class="rounded-lg border border-line bg-surface-2 p-6 hover:border-line-strong"
              >
                <h2 class="text-h3">Resident portal</h2>
                <p class="mt-2 text-sm text-ink-muted">
                  Pay rent and submit maintenance requests.
                </p>
              </a>
            </div>
          </>
        ) : (
          <>
            <p class="mt-5 text-lead text-ink-muted">
              Our owner and resident portals are being set up now. Until they
              are live, statements, documents and maintenance requests all go
              through us directly, and nothing about your property waits on a
              login.
            </p>

            <div class="mt-10 rounded-lg border border-line bg-surface-2 p-6">
              <h2 class="text-h3">In the meantime</h2>
              <ul class="mt-4 space-y-3 text-ink-muted">
                <li>
                  Owners receive monthly statements and year-end summaries by
                  email.
                </li>
                <li>
                  Maintenance requests reach us by phone or email, day or
                  night for emergencies.
                </li>
                <li>
                  Rent payments and owner disbursements are handled by ACH or
                  check.
                </li>
              </ul>
              <p class="mt-6 text-sm text-ink-muted">
                Questions about any of it? Call <a
                  href={CONTACT.phoneHref}
                  class="font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4"
                  >{CONTACT.phone}</a
                >.
              </p>
            </div>
          </>
        )
      }
    </div>
  </Section>

  <Cta />
</BaseLayout>
