---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/Section.astro';
import { NAV } from '~/config/site';
---

<BaseLayout
  title="Page Not Found"
  description="That page does not exist. Here is where everything else lives."
  noindex
>
  <Section>
    <div class="max-w-2xl">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-display">That page does not exist</h1>
      <p class="mt-5 text-lead text-ink-muted">
        The link may be out of date, or the address may have a typo in it.
        Everything on the site is one click away below.
      </p>

      <nav aria-label="All pages" class="mt-10">
        <ul class="divide-y divide-line border-y border-line">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-14 items-center font-medium text-ink hover:text-accent"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a href="/" class="btn btn-primary mt-10">Back to home</a>
    </div>
  </Section>
</BaseLayout>
