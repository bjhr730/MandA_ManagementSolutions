---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Cta from '~/components/Cta.astro';
import Disclosure from '~/components/Disclosure.astro';
import JsonLd from '~/components/JsonLd.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';

import {
  FEE_CATEGORIES,
  INVOLVEMENT,
  NO_TERMINATION_FEE,
  PLANS_INTRO,
  WHATS_INCLUDED,
} from '~/content/management-plans';
import {
  PRICING_DISCLOSURE,
  TERMINATION_QUALIFIER,
} from '~/config/compliance';
import { breadcrumbs } from '~/lib/schema';
---

<BaseLayout
  title="Management Plans"
  description="Management services and pricing are customized to your property and goals, with every applicable fee disclosed in your written proposal. Request a personalized management proposal."
>
  <JsonLd
    slot="head"
    schema={breadcrumbs([{ name: 'Management Plans', path: '/management-plans' }])}
  />

  <PageHeader
    eyebrow="Management plans"
    title="Customized management, not a rate card"
    lead="Tell us about the property and what you want from management, and we will put a written proposal in front of you."
  />

  <Section labelledby="approach-heading">
    <div class="max-w-3xl">
      <h2 id="approach-heading" class="sr-only">Our pricing approach</h2>
      <p class="text-lead text-ink-muted">{PLANS_INTRO}</p>
    </div>
  </Section>

  <Section tone="muted" labelledby="involvement-heading">
    <p class="eyebrow">Your call</p>
    <h2 id="involvement-heading" class="mt-3 max-w-2xl text-h2">
      How involved do you want to be?
    </h2>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        INVOLVEMENT.map((option) => (
          <li class="rounded-lg border border-line bg-surface p-6">
            <h3 class="text-h3">{option.title}</h3>
            <p class="mt-3 text-ink-muted">{option.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section labelledby="included-heading">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 id="included-heading" class="text-h2">
          What management typically covers
        </h2>
        <ul class="mt-8 space-y-3">
          {
            WHATS_INCLUDED.map((item) => (
              <li class="flex gap-3">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-1 size-4 shrink-0 text-accent"
                >
                  <path d="m4 10.5 4 4 8-9" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-h2">Fees you may see in a proposal</h2>
        <p class="mt-4 text-ink-muted">
          Which of these apply depends on the engagement. All of them are named
          and explained in writing before you sign anything.
        </p>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {
            FEE_CATEGORIES.map((fee) => (
              <li class="py-4 font-medium text-ink">{fee}</li>
            ))
          }
        </ul>

        <div class="mt-8">
          <Disclosure label="Pricing">
            <p>{PRICING_DISCLOSURE}</p>
          </Disclosure>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="inverse" labelledby="termination-heading">
    <div class="max-w-2xl">
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-bronze-300">
        No lock-in
      </p>
      <h2 id="termination-heading" class="mt-3 text-h2 text-white">
        {NO_TERMINATION_FEE.headline}
      </h2>
      <p class="mt-5 text-lead text-silver-200">{NO_TERMINATION_FEE.body}</p>
      <p class="mt-6 text-sm leading-relaxed text-silver-400">
        {TERMINATION_QUALIFIER}
      </p>
    </div>
  </Section>

  <Cta
    heading="Request a personalized management proposal"
    body="Send us the property details and we will come back with a proposal built around it, every applicable fee disclosed."
    showDisclosure={false}
  />
</BaseLayout>
