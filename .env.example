# Copy to `.env` and fill in. Never commit `.env`.
# In production these are set as Vercel project environment variables instead.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Drives canonical tags, sitemap.xml,
# robots.txt and Open Graph URLs. Must be the real domain before launch.
SITE_URL="https://replace-me.example.com"

# ---------------------------------------------------------------------------
# Lead notifications (Resend — https://resend.com)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, or delivery will fail.
INQUIRY_FROM_EMAIL="website@replace-me.example.com"
# Where owner inquiries are delivered.
INQUIRY_TO_EMAIL="antonio@replace-me.example.com"

# ---------------------------------------------------------------------------
# Lead storage (Neon Postgres — https://neon.tech)
# ---------------------------------------------------------------------------
# Pooled connection string.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Spam protection (Cloudflare Turnstile — https://dash.cloudflare.com)
# ---------------------------------------------------------------------------
# Leave BOTH blank in local development to skip the Turnstile check entirely.
# Both must be set in production or the form will reject every submission.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
